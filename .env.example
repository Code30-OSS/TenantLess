# Copy to .env and adjust. The mock server + generator read DATABASE_URL;
# the postgres-sim container is created from POSTGRES_DB/USER/PASSWORD.
# These are LOCAL-ONLY dev defaults: a fresh `cp .env.example .env` works as-is
# against the docker-compose Postgres on :5433. Use a strong password for any
# non-local deployment.
DATABASE_URL=postgres://tenantless:tenantless_dev@localhost:5433/tenantless
POSTGRES_DB=tenantless
POSTGRES_USER=tenantless
POSTGRES_PASSWORD=tenantless_dev
